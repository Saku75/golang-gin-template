# Copy to .env for local development. Air loads it on every restart.

# development, staging, or release. Development runs Gin in debug mode.
MODE=development

PORT=8080

# debug, info, warn, or error.
LOG_LEVEL=info

# text or json.
LOG_FORMAT=text

# Comma-separated IPs or CIDRs whose X-Forwarded-For header is trusted,
# e.g. 10.0.0.0/8,192.168.1.10. Empty trusts none.
TRUSTED_PROXIES=

# Comma-separated origins allowed from browsers, e.g.
# https://app.example.com,http://localhost:5173. * allows all. Empty sends no
# CORS headers.
CORS_ALLOWED_ORIGINS=

# How long to keep serving after SIGTERM while /readyz fails, so load
# balancers stop routing here first. Defaults to 15s; 0s exits at once.
SHUTDOWN_DELAY=0s
