# Copy to .env for local development. Air loads .env on every restart.

# Runtime mode: development, staging, or release.
# Development runs Gin in debug mode; staging and release run it in release mode.
MODE=development

# Port the API listens on.
PORT=8080

# Minimum level to log: debug, info, warn, or error.
LOG_LEVEL=info

# Log output format: text or json.
LOG_FORMAT=text

# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For header
# is trusted, for example 10.0.0.0/8,192.168.1.10. Leave empty to trust none.
TRUSTED_PROXIES=

# Comma-separated origins allowed to call the API from a browser, for example
# https://app.example.com,http://localhost:5173. Use * to allow every origin.
# Leave empty to send no CORS headers at all.
CORS_ALLOWED_ORIGINS=

# How long to keep serving after SIGTERM while the readiness probe fails, so
# load balancers stop routing here before connections are refused. A Go
# duration; the default is 15s. 0s makes Ctrl-C exit at once in local dev.
SHUTDOWN_DELAY=0s
